{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint -c ../.eslintrc.cjs src --ext ts,tsx",
    "test": "vitest run --coverage",
