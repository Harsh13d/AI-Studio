{
  "name": "backend",
  "version": "1.0.0",
  "description": "Modelia AI Studio backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development DATABASE_URL=\"file:./dev.db\" ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint -c ../.eslintrc.cjs \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "test": "cross-env DATABASE_URL=\"file:./test.db\" NODE_ENV=test prisma generate && cross-env DATABASE_URL=\"file:./test.db\" NODE_ENV=test prisma migrate deploy && cross-env DATABASE_URL=\"file:./test.db\" NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env DATABASE_URL=\"file:./test.db\" NODE_ENV=test jest --watch"
  },
  "keywords": [],
  "author": "Dev Harsh",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "prisma": "^5.19.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.2.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
